        }
      ],
      "finding_severity": "major"
    },
    {
      "id": "ICP-P4",
      "rule": "Reach/demographic data must not be used to raise ICP score",
      "field": "*",
      "method": "policy",
      "params": {
        "note": "Minions EN reach skewed SE/founders; score the EM/Director angle"
      },
      "category": "icp",
      "severity": "warn",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
