  "scoring": {
    "apply": "sum components, add points_delta from fired checks, clamp 0..100; if any block fired cap brand_score at 74",
    "brand_score": [
      {
        "id": "BR-1",
        "rule": "Evidence before diagnosis",
        "max_points": 15
      },
      {
        "id": "BR-2",
        "rule": "Names the working pattern/system, not a person's flaw",
        "max_points": 10
      },
      {
        "id": "BR-3",
        "rule": "Promise alignment: decisions come back to you / needed at the right level / judgment vs waiting",
        "max_points": 15
      },
      {
        "id": "BR-4",
        "rule": "Human at start (requirement) and end (judgment/approval); deterministic gates in the middle",
        "max_points": 10
      },
      {
        "id": "BR-5",
        "rule": "Concrete traceable evidence; 8 if concrete but number-free; 0 if opinion only",
        "max_points": 15
      },
      {
        "id": "BR-6",
        "rule": "One reversible, testable move or question",
        "max_points": 10
      },
      {
        "id": "BR-7",
        "rule": "Calm, direct practitioner tone; real trade-offs",
        "max_points": 10
      },
      {
        "id": "BR-8",
        "rule": "CTA: 10 specific situational question; 5 generic-but-relevant; 0 none/'Thoughts?'",
        "max_points": 10
      },
      {
        "id": "BR-9",
        "rule": "Native HE/EN craft, no calques",
        "max_points": 5
      }
    ],
    "icp_relevance_score": [
