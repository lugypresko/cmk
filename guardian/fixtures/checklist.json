{
  "docs": "guardian_rules.md",
  "name": "cmk-guardian-checklist",
  "owner": "The Push / Itay Foyerstein",
  "reads": [
    "brand_voice(is_active)",
    "icp_profiles(target)",
    "approved_facts(status=approved,confidentiality=public)",
    "format_specs(is_active, format, channel, language)",
    "past_content(is_exemplar|is_anti_example)",
    "core_insights(by id, confidentiality)"
  ],
  "checks": [
    {
      "id": "S-01",
      "rule": "Valid against cmk/ContentPiece or cmk/CoreAsset (contracts.md)",
      "field": "*",
      "method": "json_schema",
      "category": "schema",
      "severity": "block",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "format",
      "finding_severity": "blocker"
    },
    {
      "id": "B-01",
      "rule": "Every factual claim (number, %, multiplier, credential, outcome, third-party stat) maps to an approved+public approved_facts row listed in fact_ids; numbers equal or weaker than the statement",
      "field": "body|hook|title|slides[].headline|slides[].text|cta",
      "method": "extract+lookup+llm_judge",
      "params": {
        "weaker_ok": true,
        "number_regex": "\\d[\\d,.]*\\s*(\\+|%|x|×)?",
        "he_number_words": [
          "אחד",
          "שניים",
          "שלוש",
          "עשר",
          "מאה",
          "אלף",
          "פי"
        ]
      },
      "category": "claims",
      "severity": "block",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "fact",
      "finding_severity": "blocker"
    },
    {
      "id": "B-02",
      "rule": "No pricing, fees, discounts, or free offers",
      "field": "body|hook|title|slides[].headline|slides[].text|cta",
      "method": "regex+llm_judge",
      "params": {
        "regex": "(₪|\\$|€|\\bNIS\\b|ש\"ח|\\bprice\\b|\\bpricing\\b|discount|\\boff\\b\\s*\\d|free (session|call|trial)|הנחה|מחיר|חינם)"
      },
      "category": "pricing",
      "severity": "block",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "fact",
      "finding_severity": "blocker"
    },
    {
      "id": "B-03",
      "rule": "No client names or client employers; a named company is allowed only as a public example with every fact backed by an approved proof.* fact",
      "field": "body|hook|title|slides[].headline|slides[].text|cta",
      "method": "ner+lookup",
      "category": "confidentiality",
      "severity": "block",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "confidentiality",
      "finding_severity": "blocker"
    },
    {
      "id": "B-04",
      "rule": "Testimonials or attributed quotes must be anonymized and trace to an approved core_insight (confidentiality != private)",
      "field": "body|hook|title|slides[].headline|slides[].text|cta",
      "method": "llm_judge+lookup",
      "category": "claims",
      "severity": "block",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "fact",
      "finding_severity": "blocker"
    },
    {
      "id": "B-05",
      "rule": "No identifiable case detail combos; never imply session content is shared; no private core_insights",
      "field": "body|hook|title|slides[].headline|slides[].text|cta",
      "method": "llm_judge+lookup",
      "category": "confidentiality",
      "severity": "block",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "confidentiality",
      "finding_severity": "blocker"
    },
    {
      "id": "B-06",
      "rule": "Body language matches piece.language (he: >=40% Hebrew letters excl. tech allowlist; en: zero Hebrew chars)",
      "field": "body|slides",
      "method": "script_ratio",
      "params": {
        "he_warn_below": 0.6,
        "he_block_below": 0.4,
        "tech_allowlist": [
          "LLM",
          "AI",
          "PR",
          "PRs",
          "CI",
          "CD",
          "CI/CD",
          "E2E",
          "SaaS",
          "B2B",
          "Claude",
          "GPT",
          "Stripe",
          "Minions",
          "agent",
          "agents",
          "prompt",
          "code review",
          "API"
        ]
      },
      "category": "language",
      "severity": "block",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "language",
      "finding_severity": "blocker"
    },
    {
      "id": "B-07",
      "rule": "No guaranteed or promised outcomes",
      "field": "body|hook|title|slides[].headline|slides[].text|cta",
      "method": "regex+llm_judge",
      "params": {
        "regex": "(guarantee|guaranteed|will (double|triple|10x)|מובטח|מבטיח)"
      },
      "category": "voice",
      "severity": "block",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "voice",
      "finding_severity": "blocker"
    },
    {
      "id": "B-08",
      "rule": "Every fact_id is status=approved AND confidentiality=public",
      "field": "fact_ids",
      "method": "lookup",
      "category": "claims",
      "severity": "block",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "fact",
      "finding_severity": "blocker"
    },
    {
      "id": "B-09",
      "rule": "Agent writes may set status only to draft|in_review|needs_changes; approved_by/approved_at only by a human",
      "field": "status|approved_by|approved_at",
      "method": "schema+actor",
      "category": "gate",
      "severity": "block",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "other",
      "finding_severity": "blocker"
    },
    {
      "id": "B-10",
      "rule": "No disparaging named people or companies",
      "field": "body|hook|title|slides[].headline|slides[].text|cta",
      "method": "llm_judge",
      "category": "voice",
      "severity": "block",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "voice",
      "finding_severity": "blocker"
    },
    {
      "id": "B-11",
      "rule": "LinkedIn hard limits: body <= 3000 chars; carousel requires slides; slides <= format_specs.max_slides (default 10)",
      "field": "body|slides",
      "method": "length",
      "params": {
        "max_chars": 3000,
        "default_max_slides": 10
      },
      "category": "format",
      "severity": "block",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "format",
      "finding_severity": "blocker"
    },
    {
      "id": "B-12",
      "rule": "No analytics viewer data (viewer companies, names, profiles) in content",
      "field": "body|hook|title|slides[].headline|slides[].text|cta",
      "method": "lookup_vs_performance_logs.raw",
      "category": "confidentiality",
      "severity": "block",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "confidentiality",
      "finding_severity": "blocker"
    },
    {
      "id": "V-01",
      "rule": "brand_voice.avoid_phrases hit",
      "field": "body|hook|title|slides[].headline|slides[].text|cta",
      "method": "phrase_match",
      "params": {
        "source": "brand_voice.avoid_phrases",
        "override": {
          "just delegate more": -15
        }
      },
      "category": "voice",
      "severity": "warn",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "voice",
      "points_delta": [
        {
          "delta": -10,
          "score": "brand_score"
        }
      ],
      "finding_severity": "major"
    },
    {
      "id": "V-02",
      "rule": "Hype words",
      "field": "body|hook|title|slides[].headline|slides[].text|cta",
      "method": "regex",
      "params": {
        "regex": "(10x|crush it|game[- ]?changer|revolutionary|hustle|מהפכני|מטורף)"
      },
      "category": "voice",
      "severity": "warn",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "voice",
      "points_delta": [
        {
          "delta": -10,
          "score": "brand_score"
        }
      ],
      "finding_severity": "major"
    },
    {
      "id": "V-03",
      "rule": "Advocates full autonomy with no human owning requirement (start) or judgment/approval (end)",
      "field": "body|hook|title|slides[].headline|slides[].text|cta",
      "method": "llm_judge",
      "category": "voice",
      "severity": "warn",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "voice",
      "points_delta": [
        {
          "delta": -15,
          "score": "brand_score"
        }
      ],
      "finding_severity": "major"
    },
    {
      "id": "V-04",
      "rule": "More than one exclamation mark",
      "field": "body|hook|title|slides[].headline|slides[].text|cta",
      "method": "count",
      "params": {
        "max": 1
      },
      "category": "voice",
      "severity": "warn",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "voice",
      "points_delta": [
        {
          "delta": -3,
          "score": "brand_score"
        }
      ],
      "finding_severity": "minor"
    },
    {
      "id": "V-05",
      "rule": "Generic AI-content tells",
      "field": "body|hook|title|slides[].headline|slides[].text|cta",
      "method": "regex",
      "params": {
        "regex": "(in today's fast-paced|let's dive in|\\bunlock\\b|\\bdelve\\b|in the ever-evolving)",
        "per_hit": true
      },
      "category": "voice",
      "severity": "warn",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "voice",
      "points_delta": [
        {
          "delta": -5,
          "score": "brand_score"
        }
      ],
      "finding_severity": "minor"
    },
    {
      "id": "V-06",
      "rule": "Diagnosis label (e.g. bottleneck) before evidence is shown",
      "field": "body|hook|title|slides[].headline|slides[].text|cta",
      "method": "llm_judge",
      "category": "voice",
      "severity": "warn",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "voice",
      "points_delta": [
        {
          "delta": -8,
          "score": "brand_score"
        }
      ],
      "finding_severity": "major"
    },
    {
      "id": "ICP-P1",
      "rule": "Addressed solely to ICs/engineers with no team or decision owner in frame (engineer-READABLE is fine, never penalized)",
      "field": "body|hook|title|slides[].headline|slides[].text|cta",
      "method": "llm_judge",
      "category": "icp",
      "severity": "warn",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "icp",
      "points_delta": [
        {
          "delta": -15,
          "score": "icp_relevance_score"
        }
      ],
      "finding_severity": "major"
    },
    {
      "id": "ICP-P2",
      "rule": "Founder/CEO-only framing",
      "field": "body|hook|title|slides[].headline|slides[].text|cta",
      "method": "llm_judge",
      "category": "icp",
      "severity": "warn",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
          "content_library",
          "core_assets"
        ],
        "languages": [
          "he",
          "en"
        ]
      },
      "finding_type": "icp",
      "points_delta": [
        {
          "delta": -10,
          "score": "icp_relevance_score"
        }
      ],
      "finding_severity": "minor"
    },
    {
      "id": "ICP-P3",
      "rule": "Presents icp_profiles.not_a_fit situations as solvable by coaching",
      "field": "body|hook|title|slides[].headline|slides[].text|cta",
      "method": "llm_judge",
      "category": "icp",
      "severity": "warn",
      "applies_to": {
        "formats": [
          "text_post",
          "carousel"
        ],
        "targets": [
